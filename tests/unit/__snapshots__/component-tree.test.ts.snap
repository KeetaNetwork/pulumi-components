    "parent": "Keeta:GCP:MigrationJob::standalone-migration",
    "type": "Keeta:GCP:CloudRunEnvManager",
    "urn": "Keeta:GCP:MigrationJob$Keeta:GCP:CloudRunEnvManager::standalone-migration-env",
  },
  {
    "aliases": [],
    "custom": true,
    "inputs": {
      "jobName": "standalone-migration-job",
      "projectId": "project-id",
      "region": "us-central1",
      "trigger": "us-central1-docker.pkg.dev/project-id/keeta/app:1",
    },
    "name": "standalone-migration-exec",
    "parent": "Keeta:GCP:MigrationJob$gcp:cloudrunv2/job:Job::standalone-migration-job",
    "type": "pulumi-nodejs:dynamic:Resource",
    "urn": "Keeta:GCP:MigrationJob$gcp:cloudrunv2/job:Job$pulumi-nodejs:dynamic:Resource::standalone-migration-exec",
  },
  {
    "aliases": [],
    "custom": true,
    "inputs": {
      "deletionProtection": false,
      "location": "us-central1",
      "template": {
        "template": {
          "containers": [
            {
              "envs": [
                {
                  "name": "MC_PSQL_DB_USER",
                  "value": "user",
                },
                {
                  "name": "MC_PSQL_DB_PASSWORD",
                  "valueSource": {
                    "secretKeyRef": {
                      "secret": "standalone-migration-env-mc-psql-db-password",
                      "version": "latest",
                    },
                  },
                },
                {
                  "name": "MC_PSQL_DB_NAME",
                  "value": "database",
                },
                {
                  "name": "MC_PSQL_DB_HOST",
                  "value": "10.0.0.5",
                },
                {
                  "name": "MC_PSQL_DB_PORT",
                  "value": "5432",
                },
                {
                  "name": "MC_PSQL_DB_SSLMODE",
                  "value": "require",
                },
                {
                  "name": "MC_PSQL_DB_CA_CERT",
                  "value": "certificate",
                },
                {
                  "name": "MC_PSQL_DB_URL",
                  "valueSource": {
                    "secretKeyRef": {
                      "secret": "standalone-migration-env-mc-psql-db-url",
                      "version": "latest",
                    },
                  },
                },
              ],
              "image": "us-central1-docker.pkg.dev/project-id/keeta/app:1",
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "512Mi",
                },
              },
            },
          ],
          "maxRetries": 1,
          "serviceAccount": "standalone-migration-sa@mock.iam.gserviceaccount.com",
          "timeout": "600s",
        },
      },
    },
    "name": "standalone-migration-job",
    "parent": "Keeta:GCP:MigrationJob::standalone-migration",
    "type": "gcp:cloudrunv2/job:Job",
    "urn": "Keeta:GCP:MigrationJob$gcp:cloudrunv2/job:Job::standalone-migration-job",
  },
  {
