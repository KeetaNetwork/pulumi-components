                },
                {
                  "name": "MC_PSQL_DB_PORT",
                  "value": "5432",
                },
                {
                  "name": "MC_PSQL_DB_SSLMODE",
                  "value": "require",
                },
                {
                  "name": "MC_PSQL_DB_CA_CERT",
                  "value": "ca-certificate.service-database-db-master",
                },
                {
                  "name": "MC_PSQL_DB_URL",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "latest",
                      "name": "service-database-env-mc-psql-db-url",
                    },
                  },
                },
                {
                  "name": "LOG_LEVEL",
                  "value": "info",
                },
              ],
              "image": "us-central1-docker.pkg.dev/project-id/keeta/app:1",
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "512Mi",
                },
              },
            },
          ],
          "serviceAccountName": "service-database-sa@mock.iam.gserviceaccount.com",
        },
      },
    },
