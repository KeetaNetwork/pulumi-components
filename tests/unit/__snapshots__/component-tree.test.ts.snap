          },
        },
        "spec": {
          "containers": [
            {
              "envs": [
                {
                  "name": "MC_PSQL_DB_USER",
                  "value": "service-database-db-db-user",
                },
                {
                  "name": "MC_PSQL_DB_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "latest",
