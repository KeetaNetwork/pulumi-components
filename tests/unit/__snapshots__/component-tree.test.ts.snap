  {
    "aliases": [],
    "custom": true,
    "inputs": {
      "defaultService": "static-web-app-lb-backend-id",
      "hostRules": [
        {
          "hosts": [
            "*",
          ],
          "pathMatcher": "all",
        },
      ],
      "pathMatchers": [
        {
          "defaultService": "static-web-app-lb-backend-id",
          "name": "all",
          "routeRules": [
            {
              "matchRules": [
                {
                  "prefixMatch": "/assets/",
                },
              ],
              "priority": 1,
              "service": "static-web-app-lb-backend-id",
            },
            {
              "matchRules": [
                {
                  "prefixMatch": "/icons/",
                },
              ],
              "priority": 2,
              "service": "static-web-app-lb-backend-id",
            },
            {
              "matchRules": [
                {
                  "prefixMatch": "/fonts/",
                },
              ],
              "priority": 3,
              "service": "static-web-app-lb-backend-id",
            },
            {
              "matchRules": [
                {
                  "prefixMatch": "/images/",
                },
              ],
              "priority": 4,
              "service": "static-web-app-lb-backend-id",
            },
            {
              "matchRules": [
                {
                  "pathTemplateMatch": "/**",
                },
              ],
              "priority": 5,
              "routeAction": {
                "urlRewrite": {
                  "pathTemplateRewrite": "/",
                },
              },
              "service": "static-web-app-lb-backend-id",
            },
          ],
        },
      ],
    },
    "name": "static-web-app-lb-url-map",
    "parent": "Keeta:GCP:StaticWebApp::static-web-app-lb",
    "type": "gcp:compute/uRLMap:URLMap",
    "urn": "Keeta:GCP:StaticWebApp$gcp:compute/uRLMap:URLMap::static-web-app-lb-url-map",
  },
